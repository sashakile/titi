#!/bin/bash
# pre-push hook: run local tests before pushing
# Aborts the push if tests fail.

set -euo pipefail

REPO_ROOT=$(git rev-parse --show-toplevel)
echo "🔍 Running pre-push checks..."

# Step 1: Verify locked-mode restore for test project
# Source project uses --force-evaluate (PublishAot=true adds RID packages)
echo "   Restoring dependencies..."
cd "$REPO_ROOT"
dotnet restore src/titi/titi.csproj --force-evaluate 2>/dev/null || {
  echo "❌ FAILED: dotnet restore source project"
  exit 1
}
dotnet restore test/titi/titi.Tests.csproj --locked-mode 2>/dev/null || {
  echo "❌ FAILED: dotnet restore --locked-mode for test project. Regenerate lock files with:"
  echo "   rm test/titi/packages.lock.json && dotnet restore test/titi/titi.Tests.csproj"
  exit 1
}

# Step 2: Run tests (exclude slow integration tests)
echo "   Running tests..."
cd "$REPO_ROOT"
dotnet test test/titi/titi.Tests.csproj --no-restore --filter "Category!=Integration" 2>&1 | tail -3
EXIT_CODE="${PIPESTATUS[0]}"

if [ "$EXIT_CODE" -ne 0 ]; then
  echo "❌ FAILED: Tests did not pass. Fix before pushing."
  exit 1
fi

echo "✅ Pre-push checks passed."
exit 0