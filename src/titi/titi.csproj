<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>titi</AssemblyName>
    <RootNamespace>titi</RootNamespace>
    <PublishAot>true</PublishAot>
    <!-- Suppress AOT analysis warnings during build (only meaningful during publish) -->
    <NoWarn>$(NoWarn);IL2026;IL3050;IL2104</NoWarn>
    <!-- Enable reflection-based JSON serialization for the testaruda adapter
         (which uses anonymous types extensively). AOT builds still use
         source-gen via TitiJsonContext for non-adapter paths. -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <!-- ClojureCLR runtime -->
    <PackageReference Include="Clojure" Version="1.12.2" />

    <!-- MSBuild graph construction and evaluation -->
    <PackageReference Include="Microsoft.Build.Locator" Version="1.11.2" />
    <PackageReference Include="Microsoft.Build" Version="18.8.2" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Framework" Version="18.8.2" ExcludeAssets="runtime" PrivateAssets="all" />

    <!-- .slnx solution file generation -->
    <PackageReference Include="Microsoft.VisualStudio.SolutionPersistence" Version="1.0.52" />
  </ItemGroup>

  <!-- Embed Clojure source files as resources -->
  <ItemGroup>
    <EmbeddedResource Include="clojure/**/*.clj" />
  </ItemGroup>

</Project>
